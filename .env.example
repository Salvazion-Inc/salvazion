# ─── Salvazion App ───────────────────────────────────────────
# Copy to .env.local and fill real values.
# Production app host: https://app.salvazion.org
# Marketing site (Canva, do not point this project there): https://www.salvazion.org

NEXT_PUBLIC_APP_URL=https://app.salvazion.org

# Supabase (project kppylfrsclkdmtpobpxd)
NEXT_PUBLIC_SUPABASE_URL=https://kppylfrsclkdmtpobpxd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# X login: keys en Supabase. Por defecto se usa OAuth 2.0 (x) y si falla el perfil, reintenta Twitter OAuth 1.0a.
# Forzar solo legacy: NEXT_PUBLIC_X_AUTH_PROVIDER=twitter

# Grok / xAI (server only)
# XAI_API_KEY=
# XAI_MODEL=grok-4.5

# Wearables OAuth token seal (production)
# WEARABLES_TOKEN_SECRET=

# Capacitor shell (optional)
# CAPACITOR_SERVER_URL=https://app.salvazion.org

# Jupiter Mobile wallet (QR / WalletConnect) — https://dashboard.reown.com/
# NEXT_PUBLIC_REOWN_PROJECT_ID=
