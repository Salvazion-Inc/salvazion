# Copy this file to .env.local and fill the values from your Supabase project.
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: only needed for admin scripts / server-side privileged ops
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Solana (optional — defaults to public mainnet RPC + $SALVAZION mint)
# NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# NEXT_PUBLIC_SALVAZION_MINT=7EiMiAx4ZMCDBqm3XiLiVHZccfuUYzu2xpDjsVJpV6D2
