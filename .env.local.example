# Copy this file to .env.local and fill the values from your Supabase project.
# Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: only needed for admin scripts / server-side privileged ops
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional: run SQL migrations from CLI (npm run db:phalanx)
# Supabase → Project Settings → Database → Database password / Connection string
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
# SUPABASE_DB_PASSWORD=your-database-password

# Grok / xAI (SpaceXAI) — server-side only for Devotional generation
# https://console.x.ai → create API key
# XAI_API_KEY=xai-...
# XAI_MODEL=grok-4.5
# XAI_BASE_URL=https://api.x.ai/v1

# Solana (optional — defaults to public mainnet RPC + $SALVAZION mint)
# NEXT_PUBLIC_SOLANA_RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
# NEXT_PUBLIC_SOLANA_NETWORK=mainnet-beta
# NEXT_PUBLIC_SALVAZION_MINT=7EiMiAx4ZMCDBqm3XiLiVHZccfuUYzu2xpDjsVJpV6D2

# Jupiter Mobile (WalletConnect / Reown) — required for QR connect with Jupiter Mobile
# Create a free project at https://dashboard.reown.com/ and paste Project ID
# NEXT_PUBLIC_REOWN_PROJECT_ID=your_reown_project_id

# Stripe Premium (Salvazion account)
# STRIPE_SECRET_KEY=sk_test_or_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# SUPABASE_SERVICE_ROLE_KEY=...
