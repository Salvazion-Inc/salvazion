# ─── Wearables OAuth + native (Phase D) ─────────────────────────
# Copy values into .env.local and Vercel → Environment Variables.
# Redirect URI for each provider must match:
#   {NEXT_PUBLIC_APP_URL}/api/wearables/oauth/{provider}/callback

NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app

# Encrypts OAuth tokens in httpOnly cookies (required in production)
WEARABLES_TOKEN_SECRET=generate-a-long-random-string

# Fitbit → https://dev.fitbit.com/
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# Oura → https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# WHOOP → https://developer.whoop.com/
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Garmin Connect Developer Program
# https://developerportal.garmin.com/
GARMIN_CLIENT_ID=
GARMIN_CLIENT_SECRET=
