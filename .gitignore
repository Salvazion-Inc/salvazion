# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor — keep android/ios source; ignore build artifacts & local SDK paths
/native/capacitor/.init-status.json
/native/capacitor/plugins/SalvazionHealth/node_modules
android/app/build
android/build
android/.gradle
android/local.properties
android/captures
android/.idea
*.apk
*.aab
ios/App/Pods
ios/App/App/public
ios/DerivedData
ios/App/output

# Video build temp frames
tmp/
