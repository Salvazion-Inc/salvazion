# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Capacitor — keep android/ios source; ignore build artifacts & local SDK paths
/native/capacitor/.init-status.json
/native/capacitor/plugins/SalvazionHealth/node_modules
android/app/build
android/build
android/.gradle
android/local.properties
android/captures
android/.idea
*.apk
*.aab
ios/App/Pods
ios/App/App/public
ios/DerivedData
ios/App/output

# Video build temp frames and local Welcome drafts
tmp/
tmp-en-README.md
tmp-gitbook-aside/

# Local research captures. Not product source.
data/freedom/*-entity.json
data/freedom/articles-body.txt
data/freedom/articles-page.html
data/freedom/articles-screenshot.png
data/freedom/initial-state.json
data/freedom/netlog.json
data/freedom/sample-tweet.json
data/freedom/usertweets-full.json
data/freedom/x-articles-catalog-partial.json
data/freedom/x-articles-full-raw.json
data/x-articles-raw.json

*.jks
*.keystore
